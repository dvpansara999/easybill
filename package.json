{
  "name": "invoice-app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:regression",
    "test:regression": "node -e \"const fs=require('fs');fs.rmSync('.test-dist',{recursive:true,force:true});\" && tsc -p tsconfig.tests.json --incremental false && node -e \"const fs=require('fs');const path=require('path');function walk(dir){for(const entry of fs.readdirSync(dir,{withFileTypes:true})){const p=path.join(dir,entry.name);if(entry.isDirectory())walk(p);else if(entry.isFile()&&p.endsWith('.js')){const extless=p.slice(0,-3);if(!fs.existsSync(extless))fs.copyFileSync(p,extless);}}}walk('.test-dist/lib');\" && node .test-dist/tests/run-regressions.js",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/run-playwright.mjs --mode local",
    "test:e2e:headed": "node scripts/run-playwright.mjs --mode local --headed",
    "test:e2e:supabase": "node scripts/run-playwright.mjs --mode supabase",
    "test:e2e:supabase:desktop": "node scripts/run-playwright.mjs --mode supabase --project desktop-chromium",
    "test:e2e:supabase:mobile": "node scripts/run-playwright.mjs --mode supabase --project mobile-chromium --project mobile-webkit --grep @mobile",
    "test:e2e:supabase:headed": "node scripts/run-playwright.mjs --mode supabase --headed",
    "test:e2e:supabase:auth": "node scripts/run-playwright.mjs --mode supabase --grep @auth",
    "test:e2e:supabase:invoices": "node scripts/run-playwright.mjs --mode supabase --grep @invoices",
    "test:e2e:supabase:pdf": "node scripts/run-playwright.mjs --mode supabase --grep @pdf",
    "test:e2e:supabase:templates": "node scripts/run-playwright.mjs --mode supabase --grep @templates",
    "test:e2e:supabase:sync": "node scripts/run-playwright.mjs --mode supabase --grep @sync",
    "test:e2e:supabase:lifecycle": "node scripts/run-playwright.mjs --mode supabase --grep @lifecycle",
    "confidence:deployment": "npm run verify && npm run validate-dev-workspace && npm run test:e2e:supabase",
    "verify": "npm run lint && npm run typecheck && npm run test:regression",
    "dev-workspace:create-accounts": "node scripts/create-dev-workspace-accounts.mjs",
    "seed-dev-workspace": "node scripts/seed-dev-workspace.mjs",
    "reset-dev-workspace": "node scripts/reset-dev-workspace.mjs",
    "validate-dev-workspace": "node scripts/validate-dev-workspace.mjs",
    "pdf:help": "node -e \"console.log('PDF: POST /api/invoice-pdf (Playwright setContent). See docs/PDF-PIPELINE.md')\""
  },
  "dependencies": {
    "@sparticuz/chromium": "^143.0.4",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "next": "^16.1.7",
    "playwright": "^1.58.2",
    "playwright-core": "^1.58.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.6",
    "react-is": "^19.2.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.0.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "^16.1.7",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5"
  }
}
